# Copy this file to .env and fill in at least DISCORD_TOKEN.
# Never commit .env — it is in .gitignore.

# --- Required ---------------------------------------------------------------
# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=

# --- Discord ----------------------------------------------------------------
# Your Discord user ID(s), comma-separated. Owners can remove any content entry.
# (Discord: Settings → Advanced → Developer Mode, then right-click yourself → Copy User ID)
OWNER_IDS=
# Server ID(s) the bot is in. Slash commands are synced there instantly.
# Leave empty to register slash commands globally instead.
GUILD_IDS=
# Optional private channel where I report new entries, removals and errors.
OWNER_LOG_CHANNEL_ID=
COMMAND_PREFIX=$
SYNC_COMMANDS=true

# --- Storage & logging ----------------------------------------------------------
# Database, backups and logs go here. Docker sets this to /data automatically.
DATA_DIR=data
LOG_LEVEL=INFO
LOG_TO_FILE=true
BACKUP_KEEP=7

# --- Memes ----------------------------------------------------------------------
SUBREDDITS=Animemes,anime_irl,hopeposting,meme,me_irl,girlsfrontline,GFLNeuralCloud,FunnyAnimals
# Optional, more reliable: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive User-Agent, ideally with your Reddit username.
REDDIT_USER_AGENT=python:botgeorge:v1.0 (private Discord bot)

# --- MP3 ------------------------------------------------------------------------
MP3_MAX_DURATION_S=900
MP3_MAX_CONCURRENT=2
# A single conversion is killed after this many seconds.
MP3_JOB_TIMEOUT_S=600

# --- yt-dlp auto-update -----------------------------------------------------------
# YouTube changes often and then old yt-dlp versions stop working. George checks
# PyPI on start, every YTDLP_UPDATE_INTERVAL_H hours and right after a download
# fails with an "outdated" error, installs the new version into DATA_DIR/yt-dlp
# and uses it for the next download. No restart needed.
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_INTERVAL_H=6
# stable = official releases; nightly = daily builds (fixes arrive sooner, less tested)
YTDLP_CHANNEL=stable
# Only needed if ffmpeg is not on PATH, e.g. C:\ffmpeg\bin
FFMPEG_LOCATION=
